<BaseLayout title="Julia Creek & Quamby"> <!-- CHANGE THIS — tab title in browser -->

  <!-- ======================================================
    HERO — the big image + text at the top of the page
  ======================================================= -->
  <section class="hero">
    <div class="hero-grid">

      <div class="hero-image">
        <img
          src="https://images.kroppix.com/road/west-of-the-coast/julia-creek-willywagtail.jpg"
          alt="willy wagtail in the warm light of a late afternoon in Julia Creek"
          title="Willy wagtail, Julia Creek"
        />
      </div>

      <div class="hero-copy">
        <h1>Julia Creek & Quamby</h1> <!-- CHANGE THIS -->

        <!-- One or two sentences about this place/journey -->
        <p>Julia Creek has a free camp on the creek that's worth the detour on its own. Wattle in season, good water, and if you're quiet at night, dunnarts. We were. One wandered close enough to photograph — a moment that felt like the outback deciding to show off a little.</p> <!-- CHANGE THIS -->

        <!-- DELETE the second <p> if you only want one paragraph -->
        <p>Quamby is known for one thing — zigzag amethyst. Purple crystal locked in ironstone matrix in a pattern you don't see anywhere else. We drove out from Julia Creek for a day of digging in red clay, and came home with dirty hands and a few pieces worth keeping. Kai came home with considerably more enthusiasm than he left with.</p>

       
      </div>

    </div>
  </section>


  <!-- ======================================================
    GALLERY SECTION — copy this block for each section
    Delete sections you don't need
  ======================================================= -->
  <section class="section">
    <div class="section-heading">
      <h2>Julia Creek</h2> <!-- CHANGE THIS -->
      <p>Optional one-line description of this section.</p> <!-- CHANGE THIS or delete this line -->
    </div>

    <div class="gallery-grid">
      {sectionOne.map(photo => <GalleryCard {...photo} />)} <!-- CHANGE sectionOne to match your array name -->
    </div>
  </section>


  <!-- SECOND SECTION — delete if not needed -->
  <section class="section">
    <div class="section-heading">
      <h2>Quamby - Fossicking</h2> <!-- CHANGE THIS -->
      <!-- No <p> here — the description line is optional, just leave it out -->
    </div>

    <div class="gallery-grid">
      {sectionTwo.map(photo => <GalleryCard {...photo} />)} <!-- CHANGE sectionTwo to match your array name -->
    </div>
  </section>


  <!-- ADD MORE SECTIONS HERE — just copy the block above -->


