<BaseLayout title="Page Title"> <!-- CHANGE THIS — tab title in browser -->

  <!-- ======================================================
    HERO — the big image + text at the top of the page
  ======================================================= -->
  <section class="hero">
    <div class="hero-grid">

      <div class="hero-image">
        <img
          src="https://images.kroppix.com/road/qld-east-coast/magnetic-island-headland-drone.jpg",
              title: "Granite headlands of Magnetic Island",
    caption: "The old timber jetty stretching toward the horizon under the afternoon sun.",
        />
      </div>

      <div class="hero-copy">
        <h1>Magnetic Island</h1> <!-- CHANGE THIS -->

        <!-- One or two sentences about this place/journey -->
        <p>Granite headlands, dry eucalyptus hills and water shifting between deep blue and tropical green. 
          Magnetic Island sits just offshore from Townsville, but much of it still feels detached from the mainland — quieter roads, 
          walking tracks through scrubland, and bays that disappear behind rocky points.</p> <!-- CHANGE THIS -->

        <p>Most of these photographs were taken around the Forts Walk and the eastern side of the island, 
          where the track climbs above Arthur Bay and Florence Bay before opening toward the Coral Sea.</p>

        <!-- ROUTE STRIP — the location crumbs at the bottom of the hero -->
        <!-- Add or remove <span> tags to match your route -->
        <!-- DELETE this whole block if you don't want a route strip -->
           </div>

    </div>
  </section>


  <!-- ======================================================
    GALLERY SECTION — copy this block for each section
    Delete sections you don't need
  ======================================================= -->
  <section class="section">
    <div class="section-heading">
      <h2>Arrival and coastline</h2> <!-- CHANGE THIS -->
      <p>Arrival in Townville, palm treese and views from castle rock.  Ferry the following morning.</p> 
    </div>

    <div class="gallery-grid">
      {sectionOne.map(photo => <GalleryCard {...photo} />)} <!-- CHANGE sectionOne to match your array name -->
    </div>
  </section>


  <!-- SECOND SECTION — delete if not needed -->
  <section class="section">
    <div class="section-heading">
      <h2>The Forts walk and jetty</h2> <!-- CHANGE THIS -->
     <p>A walking track through dry woodland and wartime ruins, with constant views back across the island and the Coral Sea.</p>
    </div>

    <div class="gallery-grid">
      {sectionTwo.map(photo => <GalleryCard {...photo} />)} <!-- CHANGE sectionTwo to match your array name -->
    </div>
  </section>


  <!-- ADD MORE SECTIONS HERE — just copy the block above -->


</BaseLayout>