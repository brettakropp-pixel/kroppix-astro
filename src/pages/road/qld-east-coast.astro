---
import GalleryCard from '../../components/GalleryCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const coast = [
  {
    image: "https://images.kroppix.com/road/qld-east-coast/finch-hatton-mountain-view.jpg",
    title: "Finch Hatton",
    caption: "Cloud shadow over green country",
    variant: "ultrawide"
  },
  {
    image: "https://images.kroppix.com/road/qld-east-coast/mackay-sugarcane-sunset.jpg",
    title: "Cane sunset",
    caption: "A warmer inland edge to the coast",
    variant: "wide"
  },
  
    {
    image: "https://images.kroppix.com/road/qld-east-coast/finch-hatton-gorge-waterfall.jpg",
    title: "Finch Hatton gorge  ",
    caption: "Rock, rainforest and running water",
    variant: "wide"
  },
  {
    image: "https://images.kroppix.com/road/qld-east-coast/eungella-nationalpark-platypus.jpg",
    title: "shhhh",
    caption: "early riser preparing for a rare moment",
    variant: "wide"
  },
  {
    image: "https://images.kroppix.com/road/qld-east-coast/eungella-nationalpark-platypus-2.jpg",
    title: "Platypus",
    caption: "Emergence of the strange one",
    variant: "wide"
  }
];

---

<BaseLayout title="QLD East Coast">

  <section class="hero">
    <div class="hero-grid">
      <div class="hero-image">
        <img src="https://images.kroppix.com/road/qld-east-coast/bargara-drone-coastline.jpg" />
      </div>

  <div class="hero-copy">
          <h1>Queensland East Coast</h1>
          <p>A loose road journey from Bargara north through cane fields, ranges, island water and bright tropical coast.</p>
          <p>This set is less about one place than the movement between them — the way the colour, weather and distance shift as the road heads north.</p>
          <div class="route-strip">
              <span>Bargara</span>
              <span>Finch Hatton</span>
              <span>Mackay</span>
              <span>Magnetic Island</span>

             </div>
      </div>
    </div>
  </section>

  <section class="section">
   <div class="section-heading">
  <h2>East Coast</h2>
  <p>Rainforest edges, coastal light, and quiet movement along the shoreline.</p>
</div>
    <div class="gallery-grid">
{coast.map(photo => <GalleryCard {...photo} />)}
    </div>
  </section>

</BaseLayout>