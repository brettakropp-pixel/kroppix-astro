---
import GalleryCard from '../../components/GalleryCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const distance = [
  {
    image: "https://images.kroppix.com/road/west-of-the-coast/fountain-springs-outback.jpg",
    title: "Fountain Springs",
    caption: "Dry hills and open ground",
    variant: "wide"
  },
  {
    image: "https://images.kroppix.com/road/west-of-the-coast/fountain-springs-outback2.jpg",
    title: "Low ridge",
    caption: "Shape and heat in the land",
    variant: "wide"
  },
  
    {
    image: "https://images.kroppix.com/road/west-of-the-coast/chinaman-creek-dam.jpg",
    title: "Chinaman Creek Dam",
    caption: "Water sitting quietly in dry country",
    variant: "ultrawide"
  },
  {
    image: "https://images.kroppix.com/road/west-of-the-coast/fountain-springs-outback-qld.jpg",
    title: "Rock and grass",
    caption: "Country holding its colour",
    variant: "wide"
  },
  {
    image: "https://images.kroppix.com/road/west-of-the-coast/chinaman-creek-dam-sunset.jpg",
    title: "Dam sunset",
    caption: "The land softening at the edge of day",
    variant: "wide"
  }
];

const light = [
  {
    image: "https://images.kroppix.com/road/west-of-the-coast/charters-tower-hill-sunset.jpg",
    title: "Charters Towers",
    caption: "A darker sky over warm stone",
    variant: "wide"
  },
  {
    image: "https://images.kroppix.com/road/west-of-the-coast/charters-sunset-bokeshi.jpg",
    title: "Grass light",
    caption: "A small flare of gold",
    variant: "wide"
  },
  {
    image: "https://images.kroppix.com/road/west-of-the-coast/julia-creek-sunset.jpg",
    title: "Julia Creek",
    caption: "A flat horizon and a wide sky",
    variant: "ultrawide"
  }
];

const encounters = [
  {
    image: "https://images.kroppix.com/road/west-of-the-coast/charters-rock-wallaby.jpg",
    title: "Wallaby",
    caption: "Still for a moment in the grass",
    variant: "wide"
  },
  {
    image: "https://images.kroppix.com/road/west-of-the-coast/julia-creek-willywagtail.jpg",
    title: "Willy wagtail",
    caption: "A small shape crossing the heat",
    variant: "wide"
  },
  {
    image: "https://images.kroppix.com/road/west-of-the-coast/ballara-camel.jpg",
    title: "Ballara camel",
    caption: "A strange roadside face",
    variant: "wide"
  }
];

const ground = [
  {
    image: "https://images.kroppix.com/road/west-of-the-coast/richmond-fossicking.jpg",
    title: "Richmond fossicking",
    caption: "A sign, a patch of ground, and time to look"
  },
  {
    image: "https://images.kroppix.com/road/west-of-the-coast/belemite.jpg",
    title: "Belemnite",
    caption: "A small piece of older time"
  },
  {
    image: "https://images.kroppix.com/road/west-of-the-coast/cloncurry-amethyst.jpg",
    title: "Cloncurry amethyst",
    caption: "Colour in the red ground"
  }
];

const traces = [
  {
    image: "https://images.kroppix.com/road/west-of-the-coast/mary-kathleen-township.jpg",
    title: "Mary Kathleen",
    caption: "The grid of a town mostly gone"
  },
  {
    image: "https://images.kroppix.com/road/west-of-the-coast/bellara-station.jpg",
    title: "Ballara station",
    caption: "A line left in dry grass"
  },
  {
    image: "https://images.kroppix.com/road/west-of-the-coast/wee-macgregor-tunnel.jpg",
    title: "Wee MacGregor",
    caption: "A tunnel framing blue sky"
  }
];
---

<BaseLayout title="West of the Coast">

  <section class="hero">
    <div class="hero-grid">
      <div class="hero-image">
        <img src="https://images.kroppix.com/road/west-of-the-coast/fountain-springs-drone.jpg" />
      </div>

      <div class="hero-copy">
        <h1>West of the Coast</h1>
        <p>A shift inland from the edge of the water into dry country, distance, and slower time.</p>
        <p>This set moves between wide land, fading light, small encounters, and time spent working the ground.</p>

        <div class="route-strip">
          <span>Charters Towers</span>
          <span>Julia Creek</span>
          <span>Richmond</span>
          <span>Cloncurry</span>
          <span>Clem Walton</span>
          <span>Ballara</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>Distance</h2>
      <p>The land opens quickly. Low hills, dry grass, and long distances where very little interrupts the horizon.</p>
    </div>
    <div class="gallery-grid">
      {distance.map(photo => <GalleryCard {...photo} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>Light</h2>
    </div>
    <div class="gallery-grid">
      {light.map(photo => <GalleryCard {...photo} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>Encounters</h2>
    </div>
    <div class="gallery-grid">
      {encounters.map(photo => <GalleryCard {...photo} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>Ground</h2>
    </div>
    <div class="gallery-grid">
      {ground.map(photo => <GalleryCard {...photo} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>Traces</h2>
    </div>
    <div class="gallery-grid">
      {traces.map(photo => <GalleryCard {...photo} />)}
    </div>
    </section>

  <!-- Lightbox HTML -->
  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" id="lightboxClose">&times;</button>
    <div class="lightbox-inner">
      <img id="lightboxImage" src="" />
      <div class="lightbox-caption" id="lightboxCaption"></div>
    </div>
  </div>


</BaseLayout>