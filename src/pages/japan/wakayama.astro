<BaseLayout title="Wakayama"> <!-- CHANGE THIS — tab title in browser -->

  <!-- ======================================================
    HERO — the big image + text at the top of the page
  ======================================================= -->
  <section class="hero">
    <div class="hero-grid">

      <div class="hero-image">
        <img
          src="https://images.kroppix.com/japan/wakayama/wakayama-kimiidera-roofline-blossom.jpg"
          alt="Founded over 1,200 years ago, Kimiidera is one of Wakayama’s most important Buddhist temples and is especially known for its early blooming sakura."                  <!-- CHANGE THIS -->
        />
      </div>

      <div class="hero-copy">
        <h1>Wakayama</h1> <!-- CHANGE THIS -->

        <!-- One or two sentences about this place/journey -->
        <p>In early spring 2009, I travelled south from Osaka into Wakayama Prefecture to visit Kimiidera, a temple long associated with the arrival of Japan’s cherry blossom season.</p> <!-- CHANGE THIS -->

        <!-- DELETE the second <p> if you only want one paragraph -->
        <p>Kimiidera is considered one of the earliest major blossom locations in the Kansai region, with flowering often beginning well before Kyoto and Nara reach full bloom. The temple sits on a hillside overlooking Wakayama city, its wooden halls and tiled rooftops emerging through layers of pale sakura.</p>
        <p>Later in the day, the trip continued further south toward Shirahama, where the coastline changes completely — steep Pacific cliffs, dark volcanic rock, and open sea replacing the quiet temple gardens inland.  </p>
        <!-- ROUTE STRIP — the location crumbs at the bottom of the hero -->
        <!-- Add or remove <span> tags to match your route -->
        <!-- DELETE this whole block if you don't want a route strip -->
        
      </div>

    </div>
  </section>


  <!-- ======================================================
    GALLERY SECTION — copy this block for each section
    Delete sections you don't need
  ======================================================= -->
  <section class="section">
    <div class="section-heading">
      <h2>Kimii-dera</h2> <!-- CHANGE THIS -->
      <p>Kimiidera is considered one of the earliest major blossom locations in the Kansai region, with flowering often beginning well before Kyoto and Nara reach full bloom. The temple sits on a hillside overlooking Wakayama city, its wooden halls and tiled rooftops emerging through layers of pale sakura.</p> <!-- CHANGE THIS or delete this line -->
    </div>

    <div class="gallery-grid">
      {sectionOne.map(photo => <GalleryCard {...photo} />)} <!-- CHANGE sectionOne to match your array name -->
    </div>
  </section>


  <!-- SECOND SECTION — delete if not needed -->
