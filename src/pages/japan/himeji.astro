    </div>

    <div class="gallery-grid">
      {sectionThree.map(photo => <GalleryCard {...photo} />)} <!-- CHANGE sectionThree to match your array name -->
    </div>
  </section>
  <!-- ADD MORE SECTIONS HERE — just copy the block above -->


</BaseLayout>