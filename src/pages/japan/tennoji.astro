<BaseLayout title="Tennoji">

  <!-- ======================================================
    HERO — the big image + text at the top of the page
  ======================================================= -->
  <section class="hero">
    <div class="hero-grid">
<div class="hero-image">
  <img loading="lazy" decoding="async" src="https://images.kroppix.com/japan/tennoji/tennoji-incence.jpg" alt="Incense and figures at Tennoji, Osaka" />
  <div class="caption">
    Tennoji. Smoke, light, and a brief human pause held inside the temple grounds.
  </div>
</div>

<div class="hero-copy">
        <h1>Tennoji</h1>

        <!-- One or two sentences about this place/journey -->
        <p>A slower walk through an older part of the city. Less polished, less deliberate, but full of small moments that don’t ask to be photographed.</p>
        
        <!-- DELETE the second <p> if you only want one paragraph -->
        <p>This wasn’t a destination so much as a drift — following temples, back streets, and whatever seemed to hold attention for a moment longer than expected.</p>

       </div>

    </div>
  </section>


  <!-- ======================================================
    GALLERY SECTION — copy this block for each section
    Delete sections you don't need
  ======================================================= -->
  <section class="section">
    <div class="section-heading">
      <h2>A day of simple detail</h2> <!-- CHANGE THIS -->
      <p>A working district that never polished itself up — old Osaka holding its ground at the edge of a city that moved on without it.</p> 
    </div>

    <div class="gallery-grid">
      {sectionOne.map(photo => <GalleryCard {...photo} />)} <!-- CHANGE sectionOne to match your array name -->
    </div>
  </section>



