---

import GalleryCard from '../../components/GalleryCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';


const sectionOne = [
  {
    image: "https://images.kroppix.com/japan/ginkakuji/kyoto-ginkakuji-cityscape.jpg", // CHANGE THIS
    title: "Kyoto beyond",
    caption: "Only from above does it begin to settle into place",
    variant: "ultrawide"
  },
  {
    image: "https://images.kroppix.com/japan/ginkakuji/kyoto-zen-garden-2.jpg",
    title: "Raked sand",
    caption: "Pattern held in quiet discipline",
    variant: "wide"      // full width
  },
  {
    image: "https://images.kroppix.com/japan/ginkakuji/kyoto-zen-garden-3.jpg",
    title: "The circle",
    caption: "Geometry without urgency",
    variant: "wide"
  },
  {
    image: "https://images.kroppix.com/japan/ginkakuji/kyoto-ginkakuji-moss.jpg",
    title: "Garden moss",
    caption: "The garden floor doing its quiet work",
    variant: "ultrawide"
  },
  {
    image: "https://images.kroppix.com/japan/ginkakuji/kyoto-ginkakuji-roof-ornament.jpg",
    title: "Roof detail",
    caption: "Weathered, but never worn",
    variant: "tall"
  },
  {
    image: "https://images.kroppix.com/japan/ginkakuji/kyoto-walkto-ginkakuji.jpg",
    title: "Rooflines and light",
    caption: "The timber detail catches the light.",
    variant: "tall"
  },
   {
    image: "https://images.kroppix.com/japan/ginkakuji/kyoto-aquaduct.jpg",
    title: "The aqueduct",
    caption: "Brick arches repeating into the distance, an older kind of infrastructure",
    variant: "tall"
  },
  {
    image: "https://images.kroppix.com/japan/ginkakuji/ginkakuji-bridge.jpg",
    title: "Crossing",
    caption: "A quiet transition from one space to the next",
    variant: "ultrawide"
  }
];
--- 


<BaseLayout title="Ginkaku-ji">
  <section class="hero">
    <div class="hero-grid">

      <div class="hero-image">
        <img
          src="https://images.kroppix.com/japan/ginkakuji/kyoto-zen-garden.jpg" 
          alt="Brief description of the image"              
        />
      </div>

      <div class="hero-copy">
        <h1>Ginkaku-ji</h1>

        <p>
A study in restraint.  
Light settles across sand, moss, and timber — nothing demanding attention, yet everything holding it.
</p>

        
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <p>
Unlike the spectacle of gold at Kinkaku-ji, Ginkaku-ji is quieter. Built as a retreat, it reflects a shift toward simplicity — what Japan calls wabi-sabi.
</p>
<p>
This set follows that path — from the approach, through sand and structure, into the softer edges of the garden.
</p>
    </div>
    <div class="gallery-grid">
      {sectionOne.map(photo => <GalleryCard {...photo} />)} <!-- CHANGE sectionOne to match your array name -->
    </div>
  </section>
</BaseLayout>