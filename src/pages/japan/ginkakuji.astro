<BaseLayout title="Ginkaku-ji"> <!-- CHANGE THIS — tab title in browser -->

  <!-- ======================================================
    HERO — the big image + text at the top of the page
  ======================================================= -->
  <section class="hero">
    <div class="hero-grid">

      <div class="hero-image">
        <img
          src="https://images.kroppix.com/japan/ginkakuji/kyoto-zen-garden.jpg" 
          alt="Brief description of the image"              
        />
      </div>

      <div class="hero-copy">
        <h1>Ginkaku-ji</h1> <!-- CHANGE THIS -->

        <!-- One or two sentences about this place/journey -->
        <p>Ginkakuji before the crowds arrived</p> <!-- CHANGE THIS -->

        
    </div>
  </section>


  <!-- ======================================================
    GALLERY SECTION — copy this block for each section
    Delete sections you don't need
  ======================================================= -->
  <section class="section">
    <div class="section-heading">
      <h2>A walk to the silver temple</h2> <!-- CHANGE THIS -->
      <p></p> <!-- CHANGE THIS or delete this line -->
    </div>

    <div class="gallery-grid">
      {sectionOne.map(photo => <GalleryCard {...photo} />)} <!-- CHANGE sectionOne to match your array name -->
    </div>
  </section>


</BaseLayout>