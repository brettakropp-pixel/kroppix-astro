<BaseLayout title="Yoshino - New Years traditions"> <!-- CHANGE THIS — tab title in browser -->

  <!-- ======================================================
    HERO — the big image + text at the top of the page
  ======================================================= -->
 <section class="hero">
  <div class="hero-grid">

    <div class="hero-image">
      <img
        src="https://images.kroppix.com/japan/yoshino-newyears/yoshino-shrine-lantern.jpg"
        alt="Lantern at Yoshino Shrine"
      />
    </div>

      <div class="hero-copy">
        <h1>Yoshino - New Year's Traditions</h1> <!-- CHANGE THIS -->

        <!-- One or two sentences about this place/journey -->
        <p>A quiet winter visit shaped by incense smoke, stone steps, lantern light and the first shrine prayers of the year.</p> <!-- CHANGE THIS -->

        <!-- DELETE the second <p> if you only want one paragraph -->
        <p>This set moves from Mika in kimono into the atmosphere of the temple grounds, then finishes on smaller details from around Yoshino.</p>

      </div>

    </div>
  </section>


  <!-- ======================================================
    GALLERY SECTION — copy this block for each section
    Delete sections you don't need
  ======================================================= -->
  <section class="section">
    <div class="section-heading">
      <h2>Mika's kimono</h2> <!-- CHANGE THIS -->
      <p>The fabric chosen from her grandmother's collection, made by a neighbour's hands. 
        Worn on New Year's Day at Yoshino, where the family's connection to Yamabushi practice runs deep.</p> <!-- CHANGE THIS or delete this line -->
    </div>

    <div class="gallery-grid">
      {sectionOne.map(photo => <GalleryCard {...photo} />)} <!-- CHANGE sectionOne to match your array name -->
    </div>
  </section>


  <!-- SECOND SECTION — delete if not needed -->
